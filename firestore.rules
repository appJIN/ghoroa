rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dr.johir@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: Anyone reads, auth users create, owner/admin update/delete
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || 
        (isAuthenticated() && resource.data.seller == request.auth.uid);

      // Reviews subcollection: Anyone reads and creates, admin can delete
      match /reviews/{reviewId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Sellers: Anyone reads, auth users create own, owner/admin update/delete
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == sellerId;
      allow update: if isAdmin() || 
        (isAuthenticated() && request.auth.uid == sellerId);
      allow delete: if isAdmin();
    }

    // Haats: Anyone reads, auth users create, owner/admin update/delete
    match /haats/{haatId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || 
        (isAuthenticated() && resource.data.sellerId == request.auth.uid);
    }

    // Orders: Anyone (buyers) can create, seller/admin can read & update
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAdmin() || 
        (isAuthenticated() && resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Seller leads (from landing page onboarding form)
    match /seller_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
